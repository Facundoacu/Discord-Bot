# ============================================================
#  ARCHIVO DE EJEMPLO: SE PUBLICA EN GITHUB.
#  NO PONGAS TOKENS NI CLAVES ACÁ.
#  Copialo como .env (sin ".example") y completá ESE archivo.
# ============================================================
# --- Obligatorio ---


# --- Opcional: links de Spotify (tema, álbum, playlist) ---
# Crear una app en https://developer.spotify.com/dashboard


# --- Opcional ---
LOG_LEVEL=INFO
# ID de un servidor de prueba: los slash commands se actualizan al instante
DEV_GUILD_ID=
MAX_QUEUE_SIZE=200
MAX_PLAYLIST_TRACKS=100
DEFAULT_VOLUME=50
# Al terminarse la cola, seguir con temas parecidos al último (true/false)
AUTOPLAY=true
IDLE_TIMEOUT_SECONDS=300
ALONE_TIMEOUT_SECONDS=60
